{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "rules"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "cycles": {
      "type": "boolean"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "from",
          "forbid",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "string",
            "minLength": 1,
            "anyOf": [
              {
                "const": "."
              },
              {
                "pattern": "^(?!/)(?!.*(?://|[\\\\*:\\x00-\\x1f]))(?!.*(?:^|/)\\.{1,2}(?:/|$))\\S(?:.*\\S)?$"
              }
            ]
          },
          "forbid": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "anyOf": [
                {
                  "const": "."
                },
                {
                  "pattern": "^(?!/)(?!.*(?://|[\\\\*:\\x00-\\x1f]))(?!.*(?:^|/)\\.{1,2}(?:/|$))\\S(?:.*\\S)?$"
                }
              ]
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "reference": {
            "type": "string"
          }
        }
      }
    }
  }
}
