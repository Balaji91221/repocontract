{
  "name": "repocontract",
  "version": "0.2.0",
  "description": "Executable TypeScript dependency boundaries",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/*": "./schemas/*"
  },
  "bin": {
    "repocontract": "./dist/cli.js"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "demo": "node src/cli.ts demo",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "start": "node dist/cli.js",
    "eval": "npm run build && node scripts/evaluate-onboarding.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5"
  },
  "files": [
    "dist",
    "README.md",
    "IMPLEMENTATION_STATUS.md",
    "examples",
    "scripts",
    "LICENSE",
    "FEATURE_MATRIX.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "docs",
    "schemas"
  ],
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Balaji91221/repocontract.git"
  },
  "homepage": "https://github.com/Balaji91221/repocontract#readme",
  "bugs": {
    "url": "https://github.com/Balaji91221/repocontract/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "architecture",
    "typescript",
    "mcp",
    "static-analysis"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
